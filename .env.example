# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GPU Sizer API (required for POST /api/v1/gpu-sizer)
# No default is provided — the service is treated as "not configured" until this is set.
# Must be https:// — plaintext http:// is only accepted for localhost/127.0.0.1.
GPU_SIZER_URL=https://your-gpu-sizer-host:7860/gpu_sizer
GPU_SIZER_USERNAME=
GPU_SIZER_PASSWORD=
GPU_SIZER_TIMEOUT_SECONDS=90

# AIConfigurator API (required for POST /api/v1/kv-cache-calc)
# No default is provided — the service is treated as "not configured" until this is set.
# Must be https:// — plaintext http:// is only accepted for localhost/127.0.0.1.
AICONFIGURATOR_API_URL=https://your-aiconfigurator-host:7860
AICONFIGURATOR_USERNAME=
AICONFIGURATOR_PASSWORD=
AICONFIGURATOR_TIMEOUT_SECONDS=90

# Pricing Admin dashboard gate (required to access /pricing-admin.html)
# No default is provided — the page returns HTTP 503 until both are set.
PRICING_ADMIN_USERNAME=
PRICING_ADMIN_PASSWORD=

# Add future env vars here as features are added:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/gpu_calc
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
